<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/talent_card_border"
        android:padding="16dp">

        <!-- [📷 Avatar Asset] -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivTalentPhoto"
            android:layout_width="75dp"
            android:layout_height="75dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_profile_placeholder"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/CircleImageView" />

        <LinearLayout
            android:id="@+id/llStars"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="@id/ivTalentPhoto"
            app:layout_constraintStart_toStartOf="@id/ivTalentPhoto"
            app:layout_constraintTop_toBottomOf="@id/ivTalentPhoto">
            <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@android:drawable/btn_star_big_on" app:tint="@color/yellow" />
            <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@android:drawable/btn_star_big_on" app:tint="@color/yellow" />
            <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@android:drawable/btn_star_big_on" app:tint="@color/yellow" />
            <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@android:drawable/btn_star_big_on" app:tint="@color/yellow" />
            <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@android:drawable/btn_star_big_on" app:tint="@color/yellow" />
        </LinearLayout>

        <!-- NAME: Banuji Hasanthika [⭐ FEATURED] -->
        <TextView
            android:id="@+id/tvTalentName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:fontFamily="serif"
            android:text="Name"
            android:textColor="@color/black"
            android:textSize="17sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/ivTalentPhoto"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvVisibilityTier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="[⭐ FEATURED]"
            android:textColor="@color/primary_magenta"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/tvTalentName"
            app:layout_constraintStart_toEndOf="@id/tvTalentName"
            app:layout_constraintTop_toTopOf="@id/tvTalentName" />

        <ImageView
            android:id="@+id/ivBookmark"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_header_film_reel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/primary_magenta" />

        <!-- CATEGORY: Actor -->
        <LinearLayout
            android:id="@+id/llRole"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            app:layout_constraintEnd_toStartOf="@id/ivBookmark"
            app:layout_constraintStart_toStartOf="@id/tvTalentName"
            app:layout_constraintTop_toBottomOf="@id/tvTalentName">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="serif" android:text="CATEGORY : " android:textColor="@color/black" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:id="@+id/tvTalentRole" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="serif" android:text="Actor" android:textColor="@color/primary_magenta" android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="serif"
            android:text="Location : Colombo"
            android:textColor="@color/black"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@id/tvTalentName"
            app:layout_constraintTop_toBottomOf="@id/llRole" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="serif"
            android:text="Available"
            android:textColor="#2E7D32"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@id/tvTalentName"
            app:layout_constraintTop_toBottomOf="@id/tvLocation" />

        <!-- Intelligence Meter -->
        <View
            android:id="@+id/divider1"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="#1A000000"
            app:layout_constraintTop_toBottomOf="@id/llStars" />

        <LinearLayout
            android:id="@+id/llIntelligence"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/divider1">
            <TextView android:id="@+id/tvYieldMeter" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.2" android:text="📊 0% Yield Profile Quality" android:textColor="@color/black" android:textSize="11sp" android:textStyle="bold" />
            <TextView android:id="@+id/tvRankingPoints" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.8" android:text="⚡ 0 Ranking Points" android:textColor="@color/primary_magenta" android:textSize="11sp" android:textStyle="bold" android:gravity="end" />
        </LinearLayout>

        <!-- [🔗 MEDIA MATRIX] -->
        <View
            android:id="@+id/divider2"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:background="#1A000000"
            app:layout_constraintTop_toBottomOf="@id/llIntelligence" />

        <LinearLayout
            android:id="@+id/llMediaMatrix"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintEnd_toStartOf="@id/btnHire"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/divider2">
            
            <TextView
                android:id="@+id/tvPortfolioLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔗 Portfolio Link"
                android:textColor="@color/primary_magenta"
                android:textSize="9sp"
                android:textStyle="bold"
                android:paddingEnd="12dp"
                android:visibility="gone"
                tools:visibility="visible"/>

            <TextView
                android:id="@+id/tvShowreelLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔗 Showreel Link"
                android:textColor="@color/primary_magenta"
                android:textSize="9sp"
                android:textStyle="bold"
                android:paddingEnd="12dp"
                android:visibility="gone"
                tools:visibility="visible"/>

            <TextView
                android:id="@+id/tvSocialMatrix"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔗 Social Matrix  |"
                android:textColor="@color/primary_magenta"
                android:textSize="9sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible"/>
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnHire"
            android:layout_width="80dp"
            android:layout_height="30dp"
            android:background="@drawable/button_rounded_magenta"
            android:text="Hire"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/llMediaMatrix" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
