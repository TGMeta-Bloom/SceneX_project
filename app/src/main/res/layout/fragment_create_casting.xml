<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/scenex_background">

    <!-- Elite Toolbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:elevation="2dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back_elite"
            app:navigationIconTint="@color/scenex_primary">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Icon Sync -->
                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_clapperboard"
                    app:tint="@color/scenex_primary" />

                <TextView
                    android:id="@+id/tvToolbarTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:fontFamily="serif"
                    android:text="Create Casting Call"
                    android:textColor="@color/scenex_primary_light"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="40dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 1. Production Information Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp"
                        android:fontFamily="serif"
                        android:text="1. Production Information"
                        android:textColor="@color/scenex_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView style="@style/AppTextStyle_BodySmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Project Title" android:textStyle="bold" android:layout_marginStart="8dp" android:layout_marginBottom="4dp"/>
                    <EditText
                        android:id="@+id/etProjectTitle"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/edittext_outline"
                        android:hint="Enter project title"
                        android:inputType="textCapWords"
                        android:paddingHorizontal="24dp"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="8dp">
                            <TextView style="@style/AppTextStyle_BodySmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Type" android:textStyle="bold" android:layout_marginStart="8dp" android:layout_marginBottom="4dp"/>
                            <AutoCompleteTextView
                                android:id="@+id/dropdownProductionType"
                                android:layout_width="match_parent"
                                android:layout_height="56dp"
                                android:background="@drawable/edittext_outline"
                                android:hint="Select"
                                android:inputType="none"
                                android:paddingHorizontal="24dp"
                                android:textSize="14sp" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.2" android:orientation="vertical">
                            <TextView style="@style/AppTextStyle_BodySmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Company" android:textStyle="bold" android:layout_marginStart="8dp" android:layout_marginBottom="4dp"/>
                            <EditText
                                android:id="@+id/etProductionCompany"
                                android:layout_width="match_parent"
                                android:layout_height="56dp"
                                android:background="@drawable/edittext_outline"
                                android:hint="Enter company"
                                android:paddingHorizontal="24dp"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView style="@style/AppTextStyle_BodySmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Director Name" android:textStyle="bold" android:layout_marginStart="8dp" android:layout_marginTop="16dp" android:layout_marginBottom="4dp"/>
                    <EditText
                        android:id="@+id/etDirectorName"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="@drawable/edittext_outline"
                        android:hint="Enter director name"
                        android:paddingHorizontal="24dp"
                        android:textSize="14sp" />

                    <TextView style="@style/AppTextStyle_BodySmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Project Synopsis" android:textStyle="bold" android:layout_marginStart="8dp" android:layout_marginTop="16dp" android:layout_marginBottom="4dp"/>
                    <EditText
                        android:id="@+id/etSynopsis"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/edittext_outline"
                        android:gravity="top"
                        android:hint="Describe the project..."
                        android:inputType="textMultiLine"
                        android:lines="4"
                        android:padding="20dp"
                        android:textSize="14sp" />

                    <TextView style="@style/AppTextStyle_BodySmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Production Language" android:textStyle="bold" android:layout_marginStart="8dp" android:layout_marginTop="16dp" android:layout_marginBottom="4dp"/>
                    <AutoCompleteTextView
                        android:id="@+id/dropdownLanguage"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="@drawable/edittext_outline"
                        android:hint="Select language"
                        android:inputType="none"
                        android:paddingHorizontal="24dp"
                        android:textSize="14sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 2. Audition Details Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp"
                        android:fontFamily="serif"
                        android:text="2. Audition Information"
                        android:textColor="@color/scenex_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView style="@style/AppTextStyle_BodySmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Audition Type" android:textStyle="bold" android:layout_marginStart="8dp" android:layout_marginBottom="4dp"/>
                    <AutoCompleteTextView
                        android:id="@+id/dropdownAuditionType"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/edittext_outline"
                        android:hint="Select audition type"
                        android:inputType="none"
                        android:paddingHorizontal="24dp"
                        android:textSize="14sp" />

                    <TextView style="@style/AppTextStyle_BodySmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Audition Date" android:textStyle="bold" android:layout_marginStart="8dp" android:layout_marginBottom="4dp"/>
                    <EditText
                        android:id="@+id/etAuditionDate"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/edittext_outline"
                        android:drawableEnd="@android:drawable/ic_menu_my_calendar"
                        android:focusable="false"
                        android:hint="Select date"
                        android:paddingHorizontal="24dp"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="8dp">
                            <TextView style="@style/AppTextStyle_BodySmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Start Time" android:textStyle="bold" android:layout_marginStart="8dp" android:layout_marginBottom="4dp"/>
                            <EditText
                                android:id="@+id/etStartTime"
                                android:layout_width="match_parent"
                                android:layout_height="56dp"
                                android:background="@drawable/edittext_outline"
                                android:focusable="false"
                                android:hint="00:00"
                                android:paddingHorizontal="24dp"
                                android:textSize="14sp" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/AppTextStyle_BodySmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="End Time" android:textStyle="bold" android:layout_marginStart="8dp" android:layout_marginBottom="4dp"/>
                            <EditText
                                android:id="@+id/etEndTime"
                                android:layout_width="match_parent"
                                android:layout_height="56dp"
                                android:background="@drawable/edittext_outline"
                                android:focusable="false"
                                android:hint="00:00"
                                android:paddingHorizontal="24dp"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView style="@style/AppTextStyle_BodySmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Audition Location" android:textStyle="bold" android:layout_marginStart="8dp" android:layout_marginTop="16dp" android:layout_marginBottom="4dp"/>
                    <EditText
                        android:id="@+id/etAuditionLocation"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/edittext_outline"
                        android:hint="Enter location"
                        android:inputType="textPostalAddress"
                        android:paddingHorizontal="24dp"
                        android:textSize="14sp" />

                    <TextView style="@style/AppTextStyle_BodySmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Submission Deadline" android:textStyle="bold" android:layout_marginStart="8dp" android:layout_marginBottom="4dp"/>
                    <EditText
                        android:id="@+id/etDeadline"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="@drawable/edittext_outline"
                        android:drawableEnd="@android:drawable/ic_menu_my_calendar"
                        android:focusable="false"
                        android:hint="Select deadline"
                        android:paddingHorizontal="24dp"
                        android:textSize="14sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 3. Role Information Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp"
                        android:fontFamily="serif"
                        android:text="3. Role Information"
                        android:textColor="@color/scenex_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView style="@style/AppTextStyle_BodySmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Role Title" android:textStyle="bold" android:layout_marginStart="8dp" android:layout_marginBottom="4dp"/>
                    <EditText
                        android:id="@+id/etRoleTitle"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/edittext_outline"
                        android:hint="e.g. Lead Male"
                        android:paddingHorizontal="24dp"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="8dp">
                            <TextView style="@style/AppTextStyle_BodySmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Gender" android:textStyle="bold" android:layout_marginStart="8dp" android:layout_marginBottom="4dp"/>
                            <AutoCompleteTextView
                                android:id="@+id/dropdownGender"
                                android:layout_width="match_parent"
                                android:layout_height="56dp"
                                android:background="@drawable/edittext_outline"
                                android:hint="Select"
                                android:inputType="none"
                                android:paddingHorizontal="24dp"
                                android:textSize="14sp" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/AppTextStyle_BodySmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Age Range" android:textStyle="bold" android:layout_marginStart="8dp" android:layout_marginBottom="4dp"/>
                            <EditText
                                android:id="@+id/etAgeRange"
                                android:layout_width="match_parent"
                                android:layout_height="56dp"
                                android:background="@drawable/edittext_outline"
                                android:hint="e.g. 20-30"
                                android:paddingHorizontal="24dp"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView style="@style/AppTextStyle_BodySmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Role Description" android:textStyle="bold" android:layout_marginStart="8dp" android:layout_marginTop="16dp" android:layout_marginBottom="4dp"/>
                    <EditText
                        android:id="@+id/etRoleDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/edittext_outline"
                        android:gravity="top"
                        android:hint="Describe the character..."
                        android:inputType="textMultiLine"
                        android:lines="3"
                        android:padding="20dp"
                        android:textSize="14sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Post Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPublish"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/scenex_primary"
                android:text="Publish Casting Call"
                android:textAllCaps="false"
                android:textSize="18sp"
                android:textStyle="bold"
                app:cornerRadius="32dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
