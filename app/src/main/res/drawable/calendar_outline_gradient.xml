<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The Gradient Border -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#A8074D"
                android:centerColor="#720056"
                android:endColor="#720056"
                android:angle="0" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <!-- The White Foreground (creates the 1.5dp border effect) -->
    <item
        android:bottom="1.5dp"
        android:left="1.5dp"
        android:right="1.5dp"
        android:top="1.5dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
            <corners android:radius="15dp" />
        </shape>
    </item>
</layer-list>
