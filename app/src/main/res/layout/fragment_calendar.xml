<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- 1. Calendar Header (Hidden in List View) -->
    <ImageView
        android:id="@+id/ivHeaderCalendar"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:src="@drawable/ic_projects"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/primary_magenta" />

    <TextView
        android:id="@+id/tvScheduleHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:fontFamily="serif"
        android:text="@string/schedule_title"
        android:textColor="@color/primary_dark"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/ivHeaderCalendar"
        app:layout_constraintStart_toEndOf="@id/ivHeaderCalendar"
        app:layout_constraintTop_toTopOf="@id/ivHeaderCalendar" />

    <!-- 2. View Toggle -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/toggleContainer"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/button_secondary_outline"
        android:padding="4dp"
        app:layout_constraintTop_toBottomOf="@id/tvScheduleHeader">

        <!-- Sliding background -->
        <View
            android:id="@+id/vToggleSelector"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@drawable/button_rounded_magenta"
            app:layout_constraintWidth_percent="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/btnCalendarView"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/calendar_view"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:elevation="2dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btnListView"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/btnListView"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/list_view"
            android:textColor="@color/black"
            android:elevation="2dp"
            app:layout_constraintStart_toEndOf="@+id/btnCalendarView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 3. Calendar Grid Group (Hidden in List View) -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/calendarScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toggleContainer">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="120dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCalendar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/primary_magenta"
                app:strokeWidth="1dp"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp">
                        <TextView
                            android:id="@+id/tvCurrentMonth"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/january_2026"
                            android:textColor="@color/black"
                            android:textSize="16sp"
                            android:fontFamily="sans-serif-medium" />
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:orientation="horizontal">
                            <ImageView android:id="@+id/btnPrevMonth" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron_down" android:rotation="90" app:tint="#BDBDBD" />
                            <ImageView android:id="@+id/btnNextMonth" android:layout_width="20dp" android:layout_height="20dp" android:layout_marginStart="16dp" android:src="@drawable/ic_chevron_down" android:rotation="-90" app:tint="#BDBDBD" />
                        </LinearLayout>
                    </RelativeLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/day_mo" android:gravity="center" android:textColor="#9E9E9E" android:textSize="12sp" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/day_tu" android:gravity="center" android:textColor="#9E9E9E" android:textSize="12sp" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/day_we" android:gravity="center" android:textColor="#9E9E9E" android:textSize="12sp" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/day_th" android:gravity="center" android:textColor="#9E9E9E" android:textSize="12sp" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/day_fr" android:gravity="center" android:textColor="#9E9E9E" android:textSize="12sp" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/day_sa" android:gravity="center" android:textColor="#9E9E9E" android:textSize="12sp" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/day_su" android:gravity="center" android:textColor="#9E9E9E" android:textSize="12sp" />
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvCalendar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                        app:spanCount="7"
                        tools:listitem="@layout/item_calendar_day" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/legendContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardCalendar">

                <View android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/calendar_dot" android:backgroundTint="@color/red" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Blocked" android:textColor="@color/black" android:textSize="10sp" android:layout_marginStart="4dp" android:layout_marginEnd="12dp" />

                <View android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/calendar_dot" android:backgroundTint="@color/calendar_blue" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cast" android:textColor="@color/black" android:textSize="10sp" android:layout_marginStart="4dp" android:layout_marginEnd="12dp" />

                <View android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/calendar_dot" android:backgroundTint="@color/calendar_orange" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Book" android:textColor="@color/black" android:textSize="10sp" android:layout_marginStart="4dp" android:layout_marginEnd="12dp" />

                <View android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/calendar_dot" android:backgroundTint="@color/calendar_green" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Wait" android:textColor="@color/black" android:textSize="10sp" android:layout_marginStart="4dp" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 4. Dashboard Host (Fullscreen Overlay for List View) -->
    <FrameLayout
        android:id="@+id/listViewContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="@color/white"
        android:elevation="10dp" />

</androidx.constraintlayout.widget.ConstraintLayout>