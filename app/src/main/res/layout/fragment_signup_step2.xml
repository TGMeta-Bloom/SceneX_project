<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Header Section with Brand Gradient -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerContainer"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/signup_header_bg" />

        <!-- 5-Step Progress Stepper matching Figma -->
        <LinearLayout
            android:id="@+id/stepperContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:orientation="horizontal"
            android:paddingHorizontal="32dp"
            app:layout_constraintTop_toTopOf="parent">
            <View android:layout_width="0dp" android:layout_height="4dp" android:layout_weight="1" android:background="@color/primary_dark" android:layout_marginEnd="4dp" />
            <View android:layout_width="0dp" android:layout_height="4dp" android:layout_weight="1" android:background="@color/primary_dark" android:layout_marginEnd="4dp" />
            <View android:layout_width="0dp" android:layout_height="4dp" android:layout_weight="1" android:background="@color/white" android:alpha="0.4" android:layout_marginEnd="4dp" />
            <View android:layout_width="0dp" android:layout_height="4dp" android:layout_weight="1" android:background="@color/white" android:alpha="0.4" android:layout_marginEnd="4dp" />
            <View android:layout_width="0dp" android:layout_height="4dp" android:layout_weight="1" android:background="@color/white" android:alpha="0.4" />
        </LinearLayout>

        <!-- Profile Picture Centered in Header - No white circle border -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivProfileImage"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_profile_placeholder"
            app:shapeAppearanceOverlay="@style/CircleImageView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/stepperContainer"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="85dp" />
            
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Main Selection Card (Sliding Sheet) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="-60dp"
        android:background="@drawable/white_card_top_rounded"
        android:padding="24dp"
        android:elevation="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerContainer">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="What’s your spotlight?"
            android:textColor="@color/black"
            android:textSize="24sp"
            android:fontFamily="serif"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Tell us your primary craft so we can match you with the right casting calls."
            android:textColor="#808080"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitle" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:scrollbars="none"
            app:layout_constraintBottom_toTopOf="@id/btnNext"
            app:layout_constraintTop_toBottomOf="@id/tvSubtitle">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupSpotlight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                app:singleSelection="true"
                app:selectionRequired="true"
                app:chipSpacingHorizontal="12dp"
                app:chipSpacingVertical="12dp">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipActor"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="160dp"
                    android:layout_height="52dp"
                    android:text="Actor"
                    android:textAlignment="center"
                    android:checkable="true"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/spotlight_chip_bg_selector"
                    app:chipStrokeColor="@color/primary_magenta"
                    app:chipStrokeWidth="1dp"
                    android:textColor="@color/spotlight_text_selector"
                    app:chipCornerRadius="26dp" />

                <com.google.android.material.chip.Chip android:id="@+id/chipSinger" style="@style/Widget.Material3.Chip.Filter" android:layout_width="160dp" android:layout_height="52dp" android:text="Singer" android:textAlignment="center" android:checkable="true" app:checkedIconVisible="false" app:chipBackgroundColor="@color/spotlight_chip_bg_selector" app:chipStrokeColor="@color/primary_magenta" app:chipStrokeWidth="1dp" android:textColor="@color/spotlight_text_selector" app:chipCornerRadius="26dp" />
                <com.google.android.material.chip.Chip android:id="@+id/chipNews" style="@style/Widget.Material3.Chip.Filter" android:layout_width="160dp" android:layout_height="52dp" android:text="News Anchor" android:textAlignment="center" android:checkable="true" app:checkedIconVisible="false" app:chipBackgroundColor="@color/spotlight_chip_bg_selector" app:chipStrokeColor="@color/primary_magenta" app:chipStrokeWidth="1dp" android:textColor="@color/spotlight_text_selector" app:chipCornerRadius="26dp" />
                <com.google.android.material.chip.Chip android:id="@+id/chipDancer" style="@style/Widget.Material3.Chip.Filter" android:layout_width="160dp" android:layout_height="52dp" android:text="Dancer" android:textAlignment="center" android:checkable="true" app:checkedIconVisible="false" app:chipBackgroundColor="@color/spotlight_chip_bg_selector" app:chipStrokeColor="@color/primary_magenta" app:chipStrokeWidth="1dp" android:textColor="@color/spotlight_text_selector" app:chipCornerRadius="26dp" />
                <com.google.android.material.chip.Chip android:id="@+id/chipVoice" style="@style/Widget.Material3.Chip.Filter" android:layout_width="160dp" android:layout_height="52dp" android:text="Voice Artist" android:textAlignment="center" android:checkable="true" app:checkedIconVisible="false" app:chipBackgroundColor="@color/spotlight_chip_bg_selector" app:chipStrokeColor="@color/primary_magenta" app:chipStrokeWidth="1dp" android:textColor="@color/spotlight_text_selector" app:chipCornerRadius="26dp" />
                <com.google.android.material.chip.Chip android:id="@+id/chipPresenter" style="@style/Widget.Material3.Chip.Filter" android:layout_width="160dp" android:layout_height="52dp" android:text="Presenter" android:textAlignment="center" android:checkable="true" app:checkedIconVisible="false" app:chipBackgroundColor="@color/spotlight_chip_bg_selector" app:chipStrokeColor="@color/primary_magenta" app:chipStrokeWidth="1dp" android:textColor="@color/spotlight_text_selector" app:chipCornerRadius="26dp" />
                <com.google.android.material.chip.Chip android:id="@+id/chipVideo" style="@style/Widget.Material3.Chip.Filter" android:layout_width="160dp" android:layout_height="52dp" android:text="Videographer" android:textAlignment="center" android:checkable="true" app:checkedIconVisible="false" app:chipBackgroundColor="@color/spotlight_chip_bg_selector" app:chipStrokeColor="@color/primary_magenta" app:chipStrokeWidth="1dp" android:textColor="@color/spotlight_text_selector" app:chipCornerRadius="26dp" />
                <com.google.android.material.chip.Chip android:id="@+id/chipPhoto" style="@style/Widget.Material3.Chip.Filter" android:layout_width="160dp" android:layout_height="52dp" android:text="Photographer" android:textAlignment="center" android:checkable="true" app:checkedIconVisible="false" app:chipBackgroundColor="@color/spotlight_chip_bg_selector" app:chipStrokeColor="@color/primary_magenta" app:chipStrokeWidth="1dp" android:textColor="@color/spotlight_text_selector" app:chipCornerRadius="26dp" />
                <com.google.android.material.chip.Chip android:id="@+id/chipModel" style="@style/Widget.Material3.Chip.Filter" android:layout_width="160dp" android:layout_height="52dp" android:text="Model" android:textAlignment="center" android:checkable="true" app:checkedIconVisible="false" app:chipBackgroundColor="@color/spotlight_chip_bg_selector" app:chipStrokeColor="@color/primary_magenta" app:chipStrokeWidth="1dp" android:textColor="@color/spotlight_text_selector" app:chipCornerRadius="26dp" />
                <com.google.android.material.chip.Chip android:id="@+id/chipChoreo" style="@style/Widget.Material3.Chip.Filter" android:layout_width="160dp" android:layout_height="52dp" android:text="Choreographer" android:textAlignment="center" android:checkable="true" app:checkedIconVisible="false" app:chipBackgroundColor="@color/spotlight_chip_bg_selector" app:chipStrokeColor="@color/primary_magenta" app:chipStrokeWidth="1dp" android:textColor="@color/spotlight_text_selector" app:chipCornerRadius="26dp" />
                <com.google.android.material.chip.Chip android:id="@+id/chipLighting" style="@style/Widget.Material3.Chip.Filter" android:layout_width="160dp" android:layout_height="52dp" android:text="Lighting Technician" android:textAlignment="center" android:checkable="true" app:checkedIconVisible="false" app:chipBackgroundColor="@color/spotlight_chip_bg_selector" app:chipStrokeColor="@color/primary_magenta" app:chipStrokeWidth="1dp" android:textColor="@color/spotlight_text_selector" app:chipCornerRadius="26dp" />
                <com.google.android.material.chip.Chip android:id="@+id/chipEditor" style="@style/Widget.Material3.Chip.Filter" android:layout_width="160dp" android:layout_height="52dp" android:text="Editor" android:textAlignment="center" android:checkable="true" app:checkedIconVisible="false" app:chipBackgroundColor="@color/spotlight_chip_bg_selector" app:chipStrokeColor="@color/primary_magenta" app:chipStrokeWidth="1dp" android:textColor="@color/spotlight_text_selector" app:chipCornerRadius="26dp" />
                <com.google.android.material.chip.Chip android:id="@+id/chipSound" style="@style/Widget.Material3.Chip.Filter" android:layout_width="160dp" android:layout_height="52dp" android:text="Sound Engineer" android:textAlignment="center" android:checkable="true" app:checkedIconVisible="false" app:chipBackgroundColor="@color/spotlight_chip_bg_selector" app:chipStrokeColor="@color/primary_magenta" app:chipStrokeWidth="1dp" android:textColor="@color/spotlight_text_selector" app:chipCornerRadius="26dp" />
                <com.google.android.material.chip.Chip android:id="@+id/chipSet" style="@style/Widget.Material3.Chip.Filter" android:layout_width="160dp" android:layout_height="52dp" android:text="Set Designer" android:textAlignment="center" android:checkable="true" app:checkedIconVisible="false" app:chipBackgroundColor="@color/spotlight_chip_bg_selector" app:chipStrokeColor="@color/primary_magenta" app:chipStrokeWidth="1dp" android:textColor="@color/spotlight_text_selector" app:chipCornerRadius="26dp" />

            </com.google.android.material.chip.ChipGroup>
        </ScrollView>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnNext"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/button_rounded_magenta"
            android:text="Next"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
