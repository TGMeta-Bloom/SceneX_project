<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:theme="@style/ThemeOverlay.Material3.Dark.ActionBar"
        android:background="@color/white">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:contentScrim="@color/primary_magenta"
            app:layout_scrollFlags="scroll|exitUntilCollapsed">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivPosterDetail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                app:layout_collapseMode="parallax"
                tools:src="@tools:sample/backgrounds/scenic" />

            <!-- The cutout effect -->
            <View
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_gravity="bottom"
                android:background="@drawable/white_card_top_rounded" />

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:layout_collapseMode="pin"
                app:navigationIcon="@drawable/ic_arrow_back"
                app:navigationIconTint="@color/white" />

        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="-30dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvProjectTitleDetail"
                style="@style/AppTextStyle_H1_Hero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="Echoes of Tomorrow" />

            <TextView
                android:id="@+id/tvRoleAndGender"
                style="@style/AppTextStyle_H3_SubSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/primary_magenta"
                android:textStyle="bold"
                tools:text="Lead Actress • Female" />

            <!-- Highlights Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="#0AEC008C"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:padding="12dp">

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tvDeadline"
                        style="@style/AppTextStyle_Caption"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:drawableStart="@drawable/ic_clock"
                        android:drawablePadding="8dp"
                        android:padding="8dp"
                        app:drawableTint="@color/primary_magenta"
                        tools:text="Oct 24" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tvCategory"
                        style="@style/AppTextStyle_Caption"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:drawableStart="@drawable/ic_talent_star"
                        android:drawablePadding="8dp"
                        android:padding="8dp"
                        app:drawableTint="@color/primary_magenta"
                        tools:text="Actor" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tvCompDetail"
                        style="@style/AppTextStyle_Caption"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:drawableStart="@drawable/ic_plus"
                        android:drawablePadding="8dp"
                        android:padding="8dp"
                        app:drawableTint="@color/primary_magenta"
                        tools:text="Paid" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tvLangDetail"
                        style="@style/AppTextStyle_Caption"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:drawableStart="@drawable/ic_chat"
                        android:drawablePadding="8dp"
                        android:padding="8dp"
                        app:drawableTint="@color/primary_magenta"
                        tools:text="Sinhala" />
                </GridLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/AppTextStyle_H2_Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Project Details" />

            <TextView
                android:id="@+id/tvProductionCompany"
                style="@style/AppTextStyle_BodySmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                tools:text="SceneX Studios" />

            <TextView
                android:id="@+id/tvDirector"
                style="@style/AppTextStyle_BodySmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                tools:text="Dir: Prasanna V." />

            <TextView
                android:id="@+id/tvSynopsis"
                style="@style/AppTextStyle_BodyLarge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/black"
                tools:text="Synopsis text..." />

            <TextView
                style="@style/AppTextStyle_H2_Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="The Role" />

            <TextView
                android:id="@+id/tvAgeRange"
                style="@style/AppTextStyle_BodySmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/primary_magenta"
                android:textStyle="bold"
                tools:text="Age: 20-30" />

            <TextView
                android:id="@+id/tvExperience"
                style="@style/AppTextStyle_BodySmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                tools:text="Intermediate" />

            <TextView
                android:id="@+id/tvSkills"
                style="@style/AppTextStyle_BodySmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                tools:text="Skills: Dance" />

            <TextView
                android:id="@+id/tvCharacterBreakdown"
                style="@style/AppTextStyle_BodyLarge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                tools:text="Breakdown text..." />

            <TextView
                style="@style/AppTextStyle_H2_Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Schedule &amp; Location" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvAuditionInfo"
                style="@style/AppTextStyle_BodyLarge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_search"
                android:drawablePadding="12dp"
                app:drawableTint="@color/primary_magenta"
                tools:text="Trace Expert City" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvShootInfo"
                style="@style/AppTextStyle_BodyLarge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:drawableStart="@drawable/ic_film_reel"
                android:drawablePadding="12dp"
                app:drawableTint="@color/primary_magenta"
                tools:text="Kandy, SL" />

            <View
                android:layout_width="match_parent"
                android:layout_height="120dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:padding="20dp"
        android:background="@android:color/transparent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApply"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/button_rounded_magenta"
            app:backgroundTint="@null"
            android:text="APPLY FOR THIS ROLE"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="28dp"
            app:elevation="8dp" />
    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>