<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF9FC"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="40dp">

        <!-- Progress Stepper (4/5 active) -->
        <LinearLayout
            android:id="@+id/stepperContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal"
            android:paddingHorizontal="32dp"
            app:layout_constraintTop_toTopOf="parent">
            <View android:layout_width="0dp" android:layout_height="4dp" android:layout_weight="1" android:background="@color/primary_dark" android:layout_marginEnd="4dp" />
            <View android:layout_width="0dp" android:layout_height="4dp" android:layout_weight="1" android:background="@color/primary_dark" android:layout_marginEnd="4dp" />
            <View android:layout_width="0dp" android:layout_height="4dp" android:layout_weight="1" android:background="@color/primary_dark" android:layout_marginEnd="4dp" />
            <View android:layout_width="0dp" android:layout_height="4dp" android:layout_weight="1" android:background="@color/primary_magenta" android:layout_marginEnd="4dp" />
            <View android:layout_width="0dp" android:layout_height="4dp" android:layout_weight="1" android:background="@color/gray" android:alpha="0.2" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="serif"
            android:text="Perfect Your Spotlight"
            android:textColor="@color/primary_magenta"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/stepperContainer" />

        <!-- Physical Specs Section -->
        <TextView
            android:id="@+id/labelPhysicalSpecs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="24dp"
            android:text="Physical Specs"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitle" />

        <androidx.cardview.widget.CardView
            android:id="@+id/cardPhysicalSpecs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="2dp"
            app:layout_constraintTop_toBottomOf="@id/labelPhysicalSpecs">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp">

                <TextView android:id="@+id/labelHeight" android:layout_width="0dp" android:layout_height="wrap_content" android:text="Height(cm) :" android:textColor="@color/black" android:textStyle="bold" app:layout_constraintEnd_toStartOf="@+id/labelBuild" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilHeight"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="8dp"
                    app:boxCornerRadiusTopStart="30dp"
                    app:boxCornerRadiusTopEnd="30dp"
                    app:boxCornerRadiusBottomStart="30dp"
                    app:boxCornerRadiusBottomEnd="30dp"
                    app:boxStrokeColor="@color/primary_magenta"
                    app:layout_constraintEnd_toStartOf="@+id/tilBuild"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/labelHeight"
                    app:hintEnabled="false">
                    <AutoCompleteTextView
                        android:id="@+id/etHeight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:hint="Select"
                        android:textSize="14sp"
                        android:paddingHorizontal="20dp"
                        android:background="@null" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView android:id="@+id/labelBuild" android:layout_width="0dp" android:layout_height="wrap_content" android:text="Build :" android:textColor="@color/black" android:textStyle="bold" app:layout_constraintEnd_toEndOf="parent" android:layout_marginStart="8dp" app:layout_constraintStart_toEndOf="@id/labelHeight" app:layout_constraintTop_toTopOf="parent" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilBuild"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:boxCornerRadiusTopStart="30dp"
                    app:boxCornerRadiusTopEnd="30dp"
                    app:boxCornerRadiusBottomStart="30dp"
                    app:boxCornerRadiusBottomEnd="30dp"
                    app:boxStrokeColor="@color/primary_magenta"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/tilHeight"
                    app:layout_constraintTop_toBottomOf="@id/labelBuild"
                    app:hintEnabled="false">
                    <AutoCompleteTextView
                        android:id="@+id/etBuild"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:hint="Select"
                        android:textSize="14sp"
                        android:paddingHorizontal="20dp"
                        android:background="@null" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView android:id="@+id/labelHair" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Hair Color :" android:textColor="@color/black" android:textStyle="bold" app:layout_constraintEnd_toStartOf="@+id/labelEye" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/tilHeight" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilHair"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="8dp"
                    app:boxCornerRadiusTopStart="30dp"
                    app:boxCornerRadiusTopEnd="30dp"
                    app:boxCornerRadiusBottomStart="30dp"
                    app:boxCornerRadiusBottomEnd="30dp"
                    app:boxStrokeColor="@color/primary_magenta"
                    app:layout_constraintEnd_toStartOf="@+id/tilEye"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/labelHair"
                    app:hintEnabled="false">
                    <AutoCompleteTextView
                        android:id="@+id/etHair"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:hint="Select"
                        android:textSize="14sp"
                        android:paddingHorizontal="20dp"
                        android:background="@null" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView android:id="@+id/labelEye" android:layout_width="0dp" android:layout_height="wrap_content" android:text="Eye Color :" android:textColor="@color/black" android:textStyle="bold" app:layout_constraintEnd_toEndOf="parent" android:layout_marginStart="8dp" app:layout_constraintStart_toEndOf="@id/labelHair" app:layout_constraintTop_toTopOf="@+id/labelHair" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilEye"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:boxCornerRadiusTopStart="30dp"
                    app:boxCornerRadiusTopEnd="30dp"
                    app:boxCornerRadiusBottomStart="30dp"
                    app:boxCornerRadiusBottomEnd="30dp"
                    app:boxStrokeColor="@color/primary_magenta"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/tilHair"
                    app:layout_constraintTop_toBottomOf="@id/labelEye"
                    app:hintEnabled="false">
                    <AutoCompleteTextView
                        android:id="@+id/etEye"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:hint="Select"
                        android:textSize="14sp"
                        android:paddingHorizontal="20dp"
                        android:background="@null" />
                </com.google.android.material.textfield.TextInputLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

        <!-- Skills Section -->
        <TextView
            android:id="@+id/labelSkills"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="24dp"
            android:text="Skills"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardPhysicalSpecs" />

        <androidx.cardview.widget.CardView
            android:id="@+id/cardSkills"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="2dp"
            app:layout_constraintTop_toBottomOf="@id/labelSkills">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="• Accents" android:textColor="@color/black" android:textStyle="bold" />
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupAccents"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <!-- Senior Fix: Unified Selectable Style -->
                    <com.google.android.material.chip.Chip style="@style/SpotlightChipStyle_Selectable" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Southern" android:checkable="true" />
                    <com.google.android.material.chip.Chip style="@style/SpotlightChipStyle_Selectable" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Up-country" android:checkable="true" />
                    <com.google.android.material.chip.Chip style="@style/SpotlightChipStyle_Selectable" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Batticaloa Tamil" android:checkable="true" />
                    <com.google.android.material.chip.Chip style="@style/SpotlightChipStyle_Selectable" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Jaffna Tamil" android:checkable="true" />
                </com.google.android.material.chip.ChipGroup>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="• Other Skills" android:textColor="@color/black" android:textStyle="bold" />
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupOtherSkills"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                </com.google.android.material.chip.ChipGroup>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilAddSkill"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:boxCornerRadiusTopStart="30dp"
                    app:boxCornerRadiusTopEnd="30dp"
                    app:boxCornerRadiusBottomStart="30dp"
                    app:boxCornerRadiusBottomEnd="30dp"
                    app:boxStrokeColor="@color/primary_magenta"
                    app:endIconTint="@color/primary_magenta"
                    app:hintEnabled="false">
                    <AutoCompleteTextView
                        android:id="@+id/etAddSkill"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="Search and add skills..."
                        android:textSize="14sp"
                        android:paddingHorizontal="20dp"
                        android:background="@null" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Media Upload Section -->
        <TextView
            android:id="@+id/labelMedia"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="24dp"
            android:text="Spotlight Evidence"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardSkills" />

        <LinearLayout
            android:id="@+id/layoutPhotoUpload"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/labelMedia">

            <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="0dp" android:layout_height="140dp" android:layout_weight="1" android:layout_marginEnd="8dp" android:background="@drawable/dashed_border">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="(Required)" android:textColor="@color/primary_magenta" android:textSize="10sp" android:textStyle="bold" app:layout_constraintTop_toTopOf="parent" app:layout_constraintEnd_toEndOf="parent" android:layout_margin="8dp" />
                <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_camera_white" app:tint="@color/primary_magenta" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toTopOf="@id/btnHeadshot" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnHeadshot" android:layout_width="wrap_content" android:layout_height="36dp" android:text="Head-shot" android:textAllCaps="false" android:textColor="@color/white" android:background="@drawable/button_rounded_magenta" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" android:layout_marginBottom="12dp" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="0dp" android:layout_height="140dp" android:layout_weight="1" android:layout_marginStart="8dp" android:background="@drawable/dashed_border">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="(Required)" android:textColor="@color/primary_magenta" android:textSize="10sp" android:textStyle="bold" app:layout_constraintTop_toTopOf="parent" app:layout_constraintEnd_toEndOf="parent" android:layout_margin="8dp" />
                <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_camera_white" app:tint="@color/primary_magenta" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toTopOf="@id/btnFullBody" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnFullBody" android:layout_width="wrap_content" android:layout_height="36dp" android:text="Full Body" android:textAllCaps="false" android:textColor="@color/white" android:background="@drawable/button_rounded_magenta" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" android:layout_marginBottom="12dp" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>

        <!-- Video Reel Link Section -->
        <TextView android:id="@+id/labelVideoLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="24dp"
            android:text="Video Reel Link (YouTube/Drive):"
            android:textColor="@color/black"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutPhotoUpload" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilVideoLink"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="8dp"
            app:boxCornerRadiusTopStart="30dp"
            app:boxCornerRadiusTopEnd="30dp"
            app:boxCornerRadiusBottomStart="30dp"
            app:boxCornerRadiusBottomEnd="30dp"
            app:boxStrokeColor="@color/primary_magenta"
            app:hintEnabled="false"
            app:layout_constraintTop_toBottomOf="@id/labelVideoLink">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etVideoLink"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Paste YouTube/Drive link"
                android:inputType="textUri"
                android:paddingHorizontal="20dp"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/tvVideoHint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="32dp"
            android:layout_marginTop="4dp"
            android:text="YouTube: Use 'Unlisted', NOT Private. Google Drive: Set sharing to 'Anyone with the link can view'."
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            app:layout_constraintTop_toBottomOf="@id/tilVideoLink"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Audio Reel Link Section -->
        <TextView android:id="@+id/labelAudioLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="20dp"
            android:text="Audio Reel Link (Optional):"
            android:textColor="@color/black"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvVideoHint" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilAudioLink"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="8dp"
            app:boxCornerRadiusTopStart="30dp"
            app:boxCornerRadiusTopEnd="30dp"
            app:boxCornerRadiusBottomStart="30dp"
            app:boxCornerRadiusBottomEnd="30dp"
            app:boxStrokeColor="@color/primary_magenta"
            app:hintEnabled="false"
            app:layout_constraintTop_toBottomOf="@id/labelAudioLink">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etAudioLink"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Paste link here"
                android:inputType="textUri"
                android:paddingHorizontal="20dp"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/tvAudioHint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="32dp"
            android:layout_marginTop="4dp"
            android:text="Drive/Cloud: Ensure 'Anyone with the link can view/listen'."
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            app:layout_constraintTop_toBottomOf="@id/tilAudioLink"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Final Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnGeneratePortfolio"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginHorizontal="48dp"
            android:layout_marginTop="40dp"
            android:background="@drawable/button_rounded_magenta"
            android:text="Generate Portfolio"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/tvAudioHint" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
