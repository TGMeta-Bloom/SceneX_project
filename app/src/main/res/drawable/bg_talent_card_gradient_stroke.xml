<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The gradient "stroke" layer -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#A8074D"
                android:endColor="#720056"
                android:angle="0" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <!-- The white background layer, inset by the stroke width (e.g., 1.5dp) -->
    <item
        android:bottom="1.5dp"
        android:left="1.5dp"
        android:right="1.5dp"
        android:top="1.5dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
            <corners android:radius="11dp" />
        </shape>
    </item>
</layer-list>