<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- 1. Decorative Header Background (Drawn first to act as base) -->
    <View
        android:id="@+id/headerBackground"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:background="@drawable/signup_header_bg"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 2. Cinematic Background Pattern Overlays (Drawn on top of background for clarity) -->
    
    <!-- Top Start Reel -->
    <ImageView
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_marginStart="-40dp"
        android:layout_marginTop="20dp"
        android:alpha="0.12"
        android:src="@drawable/ic_header_film_reel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/white" />

    <!-- Top End Strip -->
    <ImageView
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_marginEnd="-50dp"
        android:layout_marginTop="120dp"
        android:alpha="0.12"
        android:rotation="15"
        android:src="@drawable/ic_figma_film_strip"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/white" />

    <!-- Middle Start Stars -->
    <ImageView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginStart="-20dp"
        android:alpha="0.08"
        android:rotation="10"
        android:src="@drawable/ic_header_play_stars"
        app:layout_constraintBottom_toTopOf="@+id/mainContentCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/primary_magenta" />

    <!-- Bottom Start Stars -->
    <ImageView
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_marginStart="-60dp"
        android:layout_marginBottom="40dp"
        android:alpha="0.08"
        android:rotation="-12"
        android:src="@drawable/ic_header_play_stars"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:tint="@color/primary_magenta" />

    <!-- Bottom End Camera -->
    <ImageView
        android:layout_width="170dp"
        android:layout_height="170dp"
        android:layout_marginEnd="-40dp"
        android:layout_marginBottom="60dp"
        android:alpha="0.08"
        android:rotation="20"
        android:src="@drawable/ic_header_movie_camera"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:tint="@color/primary_magenta" />

    <!-- 3. Central Focused Interaction Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/mainContentCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        app:cardCornerRadius="32dp"
        app:cardElevation="16dp"
        app:strokeWidth="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0.55">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp">

            <ImageView
                android:id="@+id/logoImage"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/ic_launcher" />

            <TextView
                android:id="@+id/titleText"
                style="@style/AppTextStyle_H1_Hero"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="How will you use SceneX?"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/subTitleText"
                style="@style/AppTextStyle_BodySmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Choose your primary role to\ncustomize your experience"
                android:textColor="@color/text_secondary" />

            <!-- Role Selection Buttons Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:gravity="center"
                android:orientation="vertical">

                <!-- Option: Talent -->
                <TextView
                    android:id="@+id/talentLabel"
                    style="@style/AppTextStyle_BodyLarge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Showcase your skills"
                    android:textColor="@color/black"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/talentButton"
                    android:layout_width="200dp"
                    android:layout_height="50dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/button_gradient_outline"
                    android:drawableStart="@drawable/ic_talent_star"
                    android:drawablePadding="16dp"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:text="Talent"
                    android:textAllCaps="false"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- Option: Recruiter -->
                <TextView
                    android:id="@+id/recruiterLabel"
                    style="@style/AppTextStyle_BodyLarge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40dp"
                    android:text="Find the perfect talent"
                    android:textColor="@color/black"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/recruiterButton"
                    android:layout_width="200dp"
                    android:layout_height="50dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/button_gradient_outline"
                    android:drawableStart="@drawable/ic_recruiter_search"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:drawablePadding="16dp"
                    android:text="Recruiter"
                    android:textAllCaps="false"
                    android:textSize="18sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
