<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#4A0038"
                android:centerColor="#8E0058"
                android:endColor="#B0006D"
                android:angle="45"
                android:type="linear" />
        </shape>
    </item>

    <item android:gravity="top|left" android:top="-20dp" android:left="-20dp">
        <rotate
            android:fromDegrees="-15"
            android:drawable="@drawable/ic_header_film_reel" />
    </item>

    <item android:gravity="top|right" android:top="20dp" android:right="-10dp">
        <rotate
            android:fromDegrees="20"
            android:drawable="@drawable/ic_header_clapperboard" />
    </item>

    <item
        android:gravity="center|left"
        android:left="40dp"
        android:drawable="@drawable/ic_figma_film_strip" />
</layer-list>