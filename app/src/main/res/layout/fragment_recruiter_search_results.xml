<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF9FC">

    <!-- Figma Header -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clTopNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView android:id="@+id/ivBack" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_arrow_back_elite" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:tint="@color/black" />
        <TextView android:id="@+id/tvDiscoveryTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="serif" android:text="SceneX Discovery" android:textColor="@color/primary_magenta" android:textSize="22sp" android:textStyle="bold" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
        <com.google.android.material.imageview.ShapeableImageView android:id="@+id/ivProfileHeader" android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_profile_placeholder" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:shapeAppearanceOverlay="@style/CircleImageView" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Integrated Search Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clSearchBar"
        android:layout_width="0dp"
        android:layout_height="42dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/search_bar_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/clTopNav">
        <ImageView android:id="@+id/ivSearchIcon" android:layout_width="18dp" android:layout_height="18dp" android:layout_marginStart="12dp" android:src="@drawable/ic_search" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:tint="@color/primary_magenta" />
        <EditText android:id="@+id/etSearch" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="8dp" android:background="@null" android:hint="Actor" android:textSize="14sp" app:layout_constraintEnd_toStartOf="@id/btnSearch" app:layout_constraintStart_toEndOf="@id/ivSearchIcon" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnSearch" android:layout_width="wrap_content" android:layout_height="30dp" android:layout_marginEnd="4dp" android:background="@drawable/button_rounded_magenta" android:paddingHorizontal="12dp" android:text="Search" android:textAllCaps="false" android:textColor="@color/white" android:textSize="10sp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/tvBestMatches"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="12dp"
        android:text="Best matches"
        android:textColor="@color/primary_magenta"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/clSearchBar" />

    <!-- Filter Toggle -->
    <LinearLayout
        android:id="@+id/btnFilterToggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_tag_outline"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvBestMatches">
        <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_filter" app:tint="@color/primary_magenta" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:text="Filter" android:textSize="12sp" />
        <ImageView android:layout_width="14dp" android:layout_height="14dp" android:layout_marginStart="4dp" android:src="@drawable/ic_chevron_down" app:tint="@color/black" />
    </LinearLayout>

    <!-- ELITE SIDE-RAIL FILTER PANEL -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cvFilterPanel"
        android:layout_width="0dp"
        android:layout_height="320dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        app:cardCornerRadius="12dp"
        app:cardElevation="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnFilterToggle">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal">
            <!-- Left Rail -->
            <LinearLayout android:layout_width="100dp" android:layout_height="match_parent" android:background="#F7F7F7" android:orientation="vertical">
                <TextView android:id="@+id/tvRailLocation" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="14dp" android:text="Location" android:textSize="12sp" android:textColor="@color/primary_magenta" android:textStyle="bold" />
                <TextView android:id="@+id/tvRailGender" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="14dp" android:text="Gender" android:textSize="12sp" />
                <TextView android:id="@+id/tvRailAge" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="14dp" android:text="Age" android:textSize="12sp" />
                <TextView android:id="@+id/tvRailHeight" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="14dp" android:text="Height" android:textSize="12sp" />
                <TextView android:id="@+id/tvRailLanguage" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="14dp" android:text="Language" android:textSize="12sp" />
                <TextView android:id="@+id/tvRailRating" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="14dp" android:text="Rating" android:textSize="12sp" />
            </LinearLayout>
            <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#E0E0E0" />
            <!-- Content Area -->
            <FrameLayout android:id="@+id/flFilterContent" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="16dp">
                <!-- Location Filter (Structured) -->
                <LinearLayout android:id="@+id/layoutFilterLocation" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Province" android:textStyle="bold" android:textSize="12sp"/>
                    <Spinner android:id="@+id/spFilterProvince" android:layout_width="match_parent" android:layout_height="36dp" android:layout_marginTop="4dp" android:background="@drawable/bg_tag_outline" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="City" android:textStyle="bold" android:textSize="12sp"/>
                    <Spinner android:id="@+id/spFilterCity" android:layout_width="match_parent" android:layout_height="36dp" android:layout_marginTop="4dp" android:background="@drawable/bg_tag_outline" />
                </LinearLayout>

                <LinearLayout android:id="@+id/layoutFilterGender" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:visibility="gone">
                    <com.google.android.material.chip.ChipGroup android:id="@+id/cgGender" android:layout_width="match_parent" android:layout_height="wrap_content" app:singleSelection="true">
                        <com.google.android.material.chip.Chip android:id="@+id/chipMale" style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Male" />
                        <com.google.android.material.chip.Chip android:id="@+id/chipFemale" style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Female" />
                        <com.google.android.material.chip.Chip android:id="@+id/chipAny" style="@style/Widget.MaterialComponents.Chip.Choice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Any" android:checked="true" />
                    </com.google.android.material.chip.ChipGroup>
                </LinearLayout>

                <!-- Age Range (Structured) -->
                <LinearLayout android:id="@+id/layoutFilterAge" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:visibility="gone">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Min Age" android:textStyle="bold" android:textSize="12sp"/>
                    <Spinner android:id="@+id/spMinAge" android:layout_width="match_parent" android:layout_height="36dp" android:layout_marginTop="4dp" android:background="@drawable/bg_tag_outline" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Max Age" android:textStyle="bold" android:textSize="12sp"/>
                    <Spinner android:id="@+id/spMaxAge" android:layout_width="match_parent" android:layout_height="36dp" android:layout_marginTop="4dp" android:background="@drawable/bg_tag_outline" />
                </LinearLayout>

                <!-- Height Range (Structured) -->
                <LinearLayout android:id="@+id/layoutFilterHeight" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:visibility="gone">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Min Height (cm)" android:textStyle="bold" android:textSize="12sp"/>
                    <Spinner android:id="@+id/spMinHeight" android:layout_width="match_parent" android:layout_height="36dp" android:layout_marginTop="4dp" android:background="@drawable/bg_tag_outline" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Max Height (cm)" android:textStyle="bold" android:textSize="12sp"/>
                    <Spinner android:id="@+id/spMaxHeight" android:layout_width="match_parent" android:layout_height="36dp" android:layout_marginTop="4dp" android:background="@drawable/bg_tag_outline" />
                </LinearLayout>

                <LinearLayout android:id="@+id/layoutFilterLanguage" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:visibility="gone">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Languages Spoken:" android:textStyle="bold" android:textSize="13sp" />
                    <CheckBox android:id="@+id/cbSinhala" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sinhala" android:layout_marginTop="4dp"/>
                    <CheckBox android:id="@+id/cbEnglish" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="English" />
                    <CheckBox android:id="@+id/cbTamil" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tamil" />
                </LinearLayout>

                <LinearLayout android:id="@+id/layoutFilterRating" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:visibility="gone">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Min Rating" android:textStyle="bold" android:textSize="13sp" />
                    <RatingBar android:id="@+id/rbMinRating" android:layout_width="wrap_content" android:layout_height="wrap_content" style="?android:attr/ratingBarStyleSmall" android:numStars="5" android:rating="3" android:layout_marginTop="8dp"/>
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvResults"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:paddingBottom="80dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cvFilterPanel" />

    <ProgressBar
        android:id="@+id/pbLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnFilterToggle" />

</androidx.constraintlayout.widget.ConstraintLayout>
