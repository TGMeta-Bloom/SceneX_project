<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.SceneX"
        tools:targetApi="31">

        <!-- 🛡️ FIX: Resolve Manifest Merger conflict between Google and Facebook SDKs -->
        <property
            android:name="android.adservices.AD_SERVICES_CONFIG"
            android:resource="@xml/ga_ad_services_config"
            tools:replace="android:resource" />

        <!-- Facebook Metadata -->
        <meta-data android:name="com.facebook.sdk.ApplicationId" android:value="@string/facebook_app_id"/>
        <meta-data android:name="com.facebook.sdk.ClientToken" android:value="@string/facebook_client_token"/>

        <activity
            android:name=".views.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.SceneX.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".views.OnboardingActivity" android:exported="false" />
        <activity android:name=".views.RoleSelectActivity" android:exported="false" />
        <activity android:name=".views.SignupActivity" android:exported="false" />
        <activity android:name=".views.LoginActivity" android:exported="false" />
        <activity android:name=".views.WaitingRoomActivity" android:exported="false" />

        <activity
            android:name=".views.AddScheduleActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity android:name=".MainActivity" android:exported="false" />
        <activity
            android:name=".views.CastingCallDetailsActivity"
            android:exported="false"
            android:theme="@style/Theme.SceneX.NoActionBar" />
        <activity
            android:name=".views.HireRequestDetailsActivity"
            android:exported="false"
            android:theme="@style/Theme.SceneX.NoActionBar" />

        <activity
            android:name=".views.RecruiterBookingDetailsActivity"
            android:exported="false" />

        <activity
            android:name=".views.TalentBookingDetailsActivity"
            android:exported="false" />

        <activity
            android:name=".views.ChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".views.NotificationsActivity"
            android:exported="false" />

        <activity
            android:name=".views.EditBookingActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustPan" />

        <activity
            android:name=".views.CastingManagementActivity"
            android:exported="false"
            android:theme="@style/Theme.SceneX.NoActionBar" />

        <!-- Facebook Activities -->
        <activity android:name="com.facebook.FacebookActivity"
            android:configChanges="keyboard|keyboardHidden|screenLayout|screenSize|orientation"
            android:label="@string/app_name" />
        <activity
            android:name="com.facebook.CustomTabActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="@string/fb_login_protocol_scheme" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.example.scenex.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>