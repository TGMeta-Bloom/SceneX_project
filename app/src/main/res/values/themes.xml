<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.SceneX" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_magenta</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- This forces the pure color globally for selectors -->
        <item name="colorControlActivated">@color/primary_magenta</item>
    </style>

    <style name="Theme.SceneX" parent="Base.Theme.SceneX" />

    <!-- The missing style required by AndroidManifest.xml -->
    <style name="Theme.SceneX.NoActionBar" parent="Theme.SceneX" />

    <!-- Specific style for pure magenta radio buttons -->
    <style name="PureMagentaRadioButton" parent="Widget.Material3.CompoundButton.RadioButton">
        <item name="useMaterialThemeColors">false</item>
        <item name="buttonTint">@color/gender_radio_selector</item>
    </style>

    <!-- Active indicator for Bottom Navigation -->
    <style name="CustomMagentaIndicator">
        <item name="android:color">#1AEC008C</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.Corner.Full</item>
    </style>

    <!-- Shapeable Image Styles -->
    <style name="CircleImageView" parent="">
        <item name="cornerSize">50%</item>
    </style>

    <!-- Calendar Day Style -->
    <style name="CalendarDay">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Spotlight Chip Style (Selectable - Senior Fix) -->
    <style name="SpotlightChipStyle_Selectable" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/spotlight_chip_bg_selector</item>
        <item name="android:textColor">@color/spotlight_text_selector</item>
        <item name="chipStrokeColor">@color/spotlight_stroke_selector</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.Corner.Full</item>
        <item name="android:textSize">12sp</item>
        <item name="showMotionSpec">@null</item>
        <item name="hideMotionSpec">@null</item>
    </style>

    <!-- Legacy styles (maintained for compatibility) -->
    <style name="SpotlightChipStyle" parent="Widget.Material3.Chip.Suggestion">
        <item name="chipBackgroundColor">@color/primary_magenta</item>
        <item name="android:textColor">@color/white</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.Corner.Full</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="SpotlightChipStyle_Light" parent="Widget.Material3.Chip.Suggestion">
        <item name="chipBackgroundColor">#F3E5F5</item>
        <item name="android:textColor">#7B1FA2</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.Corner.Full</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- Text Styles -->
    <style name="AppTextStyle_H0_Hero">
        <item name="android:textSize">36sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="AppTextStyle_H1_Hero">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="AppTextStyle_H2_Section">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="AppTextStyle_H3_SubSection">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="AppTextStyle_BodyLarge">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="AppTextStyle_BodySmall">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="AppTextStyle_Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/gray</item>
    </style>

    <!-- Premium Dialog Style -->
    <style name="CustomAlertDialog" parent="Theme.Material3.DayNight.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
        <item name="android:windowElevation">8dp</item>
    </style>

</resources>
