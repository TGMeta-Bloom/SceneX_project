<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SceneX"
        tools:targetApi="31">
        
        <activity
            android:name=".views.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.SceneX.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".views.OnboardingActivity" android:exported="false" />
        <activity android:name=".views.RoleSelectActivity" android:exported="false" />
        <activity android:name=".views.SignupActivity" android:exported="false" />
        <activity android:name=".views.LoginActivity" android:exported="false" />
        <activity android:name=".views.WaitingRoomActivity" android:exported="false" />
        <activity android:name=".MainActivity" android:exported="false" />
        <activity
            android:name=".views.CastingCallDetailsActivity"
            android:exported="false"
            android:theme="@style/Theme.SceneX.NoActionBar" />
        <activity
            android:name=".views.HireRequestDetailsActivity"
            android:exported="false"
            android:theme="@style/Theme.SceneX.NoActionBar" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.example.scenex.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
